  "puzzles": [
    { "id": "przeszukanie", "name": "Przeszukanie holu", "hints": ["Przeszukajcie hol. Ktoś tu zgubił identyfikator.", "Zajrzyjcie do donicy z rośliną."], "when": { "input": "badge_found", "equals": "found" } },
    {
      "id": "telefon", "name": "Telefon recepcjonistki", "hints": ["Reklama w holu coś rysuje. Patrzcie na palec.", "Narysujcie ten sam kształt na dziewięciu przyciskach telefonu."],
      "when": { "sequence": [
        { "input": "phone_key", "equals": "1" }, { "input": "phone_key", "equals": "2" }, { "input": "phone_key", "equals": "3" },
        { "input": "phone_key", "equals": "5" }, { "input": "phone_key", "equals": "7" }, { "input": "phone_key", "equals": "8" },
        { "input": "phone_key", "equals": "9" } ] }
    },
    { "id": "szafka", "name": "Grafik i szafka ochrony", "hints": ["Grafik ochrony na monitorze. Kto ma dziś dyżur?", "Kod szafki to godziny zmiany dyżurnego, np. 06–14 daje 0614."], "after": ["telefon"], "when": { "input": "locker_code", "equals": "0614" } },
    {
      "id": "bramka", "name": "Bramka", "hints": ["Bramka wpuści tylko jedną osobę z ochrony.", "Pokażcie kamerze identyfikator dzisiejszego dyżurnego."], "after": ["szafka", "przeszukanie"],
      "when": { "input": "gate_qr", "equals": "OCHRONA-MAREK" },
      "then": [ { "output": "door_winda", "value": "open" } ]
    },
    {
      "id": "sciana", "name": "Ściana powiadomień", "hints": ["Raport czasu ekranowego mówi, co wciąga najmocniej.", "Ułóżcie telefony od najdłuższego do najkrótszego czasu z raportu."], "after": ["bramka"],
      "when": { "all": [
        { "input": "slot1", "equals": "Z-FEED" }, { "input": "slot2", "equals": "Z-BET" }, { "input": "slot3", "equals": "Z-DATE" },
        { "input": "slot4", "equals": "Z-NEWS" }, { "input": "slot5", "equals": "Z-PLAY" }, { "input": "slot6", "equals": "Z-FIT" } ] }
    },
    {
      "id": "zdrive", "name": "Kokpit Z-Drive", "hints": ["Instrukcja serwisowa leży na fotelu. Czytajcie kod z ekranu.", "SRV to ciśnienie, temperatura i obroty. Ustawcie je pokrętłami."], "after": ["bramka"],
      "when": { "all": [
        { "input": "knob_pressure", "gt": 2.35 }, { "input": "knob_pressure", "lt": 2.45 },
        { "input": "knob_temp", "gt": 87.5 }, { "input": "knob_temp", "lt": 92.5 },
        { "input": "knob_rpm", "gt": 3150 }, { "input": "knob_rpm", "lt": 3250 } ] }
    },
    {
      "id": "zmart", "name": "Kasa Z-Mart", "hints": ["Kiosk pokazuje klientkę, plakaty mówią, co algorytm jej wciśnie.", "Zeskanujcie przy kasie cztery produkty dla niej, w kolejności z plakatów."], "after": ["bramka"],
      "when": { "sequence": [
        { "input": "mart_qr", "equals": "Z-BOOST" }, { "input": "mart_qr", "equals": "Z-KIDS" },
        { "input": "mart_qr", "equals": "Z-SNACK" }, { "input": "mart_qr", "equals": "Z-SEN" } ] }
    },
    {
      "id": "skanery", "name": "Skanery dłoni", "hints": ["Skanery dłoni nie zapalają się przypadkiem.", "Dwie osoby, dwa zapalone skanery, dłonie razem przez trzy sekundy."], "after": ["sciana", "zdrive", "zmart"],
      "when": { "all": [ { "input": "scanner2", "equals": "ON" }, { "input": "scanner3", "equals": "ON" } ] },
      "then": [ { "output": "door_zejscie", "value": "open" } ]
    },
    {
      "id": "firewall", "name": "Firewall ze światła", "hints": ["Diody nad czujnikami pokazują cele.", "Obróćcie lustra tak, żeby każda wiązka trafiła w czujnik z zapaloną diodą."], "after": ["skanery"],
      "when": { "all": [ { "input": "light1", "gt": 600 }, { "input": "light3", "gt": 600 }, { "input": "light4", "gt": 600 } ] }
    },
    {
      "id": "uzbrojenie", "name": "Uzbrojenie", "hints": ["Trzy rdzenie do skrzyni, potem kod z trzech fragmentów.", "Hasło ZETY mówi, w jakiej kolejności wpisać fragmenty ze stanowisk."], "after": ["firewall"],
      "when": { "all": [
        { "input": "rod1", "equals": "ROD" }, { "input": "rod2", "equals": "ROD" }, { "input": "rod3", "equals": "ROD" },
        { "input": "bomb_code", "equals": "835127" } ] }
    },
    {
      "id": "detonacja", "name": "Detonacja", "hints": ["Dwa zamki, dwa klucze. Szafa serwisowa.", "Przekręćcie oba klucze w tej samej chwili."], "after": ["uzbrojenie"], "ends": true,
      "when": { "all": [ { "input": "key_left", "equals": "ON" }, { "input": "key_right", "equals": "ON" } ] },
      "then": [ { "output": "door_wyjscie", "value": "open" } ]
    },
    {
      "id": "uklad", "name": "Układ z ZETĄ", "after": ["uzbrojenie"], "ends": true,
      "when": { "input": "accept", "equals": "PRESSED" },
      "then": [ { "output": "door_wyjscie", "value": "open" } ]
    }
  ],
  "characters": [
    {
      "name": "KRUK", "output": "voice", "voice": "N2lVS1w4EtoT3dr4eOWO",
      "about": "Nomad z ekipy w aucie pod wieżą, mówi przez radio. Krótko, po ulicznemu, zawsze po stronie graczy. Daje podpowiedzi."
    },
    {
      "name": "ZETA", "output": "voice", "screen": "screen_zeta", "voice": "XB0fDUnXU5powFXDhCwa",
      "about": "Sztuczna inteligencja Korporacji Z, antagonistka. W holu uprzejma jak recepcja, na piętrze kpiąca, w Jądrze kusząca. Nigdy nie kłamie o zagadkach."
    }
  ],
  "twists": {
    "patrol": {
      "about": "ZETA ogłasza patrol na Piętrze Nawyków: przez 20 sekund nikt nie może się ruszyć.",
      "after": ["bramka"], "blocks": ["skanery"],
      "then": [ { "output": "twist", "value": { "kind": "patrol", "seconds": 20 } } ]
    },
    "blackout": {
      "about": "Zaciemnienie w holu albo na piętrze: przez 60 sekund świeci tylko UV i oznaczenia wyjść, praca idzie wolniej.",
      "blocks": ["skanery"],
      "then": [ { "output": "twist", "value": { "kind": "blackout", "seconds": 60 } } ]
    },
    "lockdown": {
      "about": "Blokada: ZETA znów zamyka zejście do Jądra. Otwiera je sekwencja trzech przycisków, którą ZETA podaje w zagadce słownej; firewall czeka na blokadę.",
      "after": ["skanery"], "blocks": ["firewall"],
      "then": [ { "output": "door_zejscie", "value": "closed" }, { "output": "twist", "value": { "kind": "lockdown", "seconds": 0 } } ],
      "adds": [
        {
          "id": "blokada", "name": "Blokada drzwi",
          "hints": ["ZETA zamknęła zejście. Panel przy drzwiach chce sekwencji.", "Zagadka ZETY mówi, które przyciski i w jakiej kolejności."],
          "when": { "sequence": [ { "input": "lockdown_panel", "equals": "1" }, { "input": "lockdown_panel", "equals": "2" }, { "input": "lockdown_panel", "equals": "3" } ] },
          "then": [ { "output": "door_zejscie", "value": "open" } ]
        }
      ]
    }
  },
