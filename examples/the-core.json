    "firewall": { "puzzle": "firewall", "about": "A lamp above the sensor stand.",
      "then": [ { "output": "lamp_firewall", "value": "ON" }, { "delay": 12000 }, { "output": "lamp_firewall", "value": "OFF" } ] },
    "arming": { "puzzle": "arming", "about": "A lamp above ZETA's console with the slogan that gives the order.",
      "then": [ { "output": "lamp_arming", "value": "ON" }, { "delay": 12000 }, { "output": "lamp_arming", "value": "OFF" } ] }
  },
  "twists": {
    "patrol": {
      "about": "ZETA announces a patrol on the Habit Floor: for 20 seconds nobody may move.",
      "after": ["gate"], "blocks": ["scanners"],
      "then": [ { "output": "twist", "value": { "kind": "patrol", "seconds": 20 } } ]
    },
    "blackout": {
      "about": "Blackout in the Lobby or on the Habit Floor: for 60 seconds only the UV and the exit signs stay lit, work goes slower.",
      "blocks": ["scanners"],
      "then": [ { "output": "twist", "value": { "kind": "blackout", "seconds": 60 } } ]
    },
    "lockdown": {
      "about": "Lockdown: ZETA closes the way down to The Core again. A sequence of three buttons opens it, which ZETA gives in a riddle; the firewall waits for the lockdown.",
      "after": ["scanners"], "blocks": ["firewall"],
      "then": [ { "output": "door_descent", "value": "closed" }, { "output": "twist", "value": { "kind": "lockdown", "seconds": 0 } } ],
      "adds": [
        {
          "id": "doorlock", "name": "Door lockdown",
          "hints": ["ZETA has closed the way down. The panel by the door wants a sequence.", "ZETA's riddle says which buttons and in what order."],
          "when": { "sequence": [ { "input": "lockdown_panel", "equals": "1" }, { "input": "lockdown_panel", "equals": "2" }, { "input": "lockdown_panel", "equals": "3" } ] },
          "then": [ { "output": "door_descent", "value": "open" } ]
        }
      ]
    }
  },
