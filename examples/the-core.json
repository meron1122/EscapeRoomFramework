  "puzzles": [
    { "id": "search", "name": "Searching the lobby", "hints": ["Search the lobby. Someone lost a badge here.", "Look in the planter with the plant."], "when": { "input": "badge_found", "equals": "found" } },
    {
      "id": "phone", "name": "The receptionist's phone", "hints": ["The ad in the lobby is drawing something. Watch the finger.", "Draw the same shape on the phone's nine buttons."],
      "when": { "sequence": [
        { "input": "phone_key", "equals": "1" }, { "input": "phone_key", "equals": "2" }, { "input": "phone_key", "equals": "3" },
        { "input": "phone_key", "equals": "5" }, { "input": "phone_key", "equals": "7" }, { "input": "phone_key", "equals": "8" },
        { "input": "phone_key", "equals": "9" } ] }
    },
    { "id": "locker", "name": "Roster and security locker", "hints": ["The security roster is on the monitor. Who is on duty today?", "The locker code is the duty guard's shift hours, e.g. 06–14 gives 0614."], "after": ["phone"], "when": { "input": "locker_code", "equals": "0614" } },
    {
      "id": "gate", "name": "Gate", "hints": ["The gate lets in only one person from security.", "Show the camera the badge of today's duty guard."], "after": ["locker", "search"],
      "when": { "input": "gate_qr", "equals": "SECURITY-MAREK" },
      "then": [ { "output": "door_elevator", "value": "open" } ]
    },
    {
      "id": "wall", "name": "Notification wall", "hints": ["The screen time report says what hooks people hardest.", "Arrange the phones from the longest to the shortest time in the report."], "after": ["gate"],
      "when": { "all": [
        { "input": "slot1", "equals": "Z-FEED" }, { "input": "slot2", "equals": "Z-BET" }, { "input": "slot3", "equals": "Z-DATE" },
        { "input": "slot4", "equals": "Z-NEWS" }, { "input": "slot5", "equals": "Z-PLAY" }, { "input": "slot6", "equals": "Z-FIT" } ] }
    },
    {
      "id": "zdrive", "name": "Z-Drive cockpit", "hints": ["The service manual is on the seat. Read the code off the screen.", "SRV is pressure, temperature and revs. Set them with the knobs."], "after": ["gate"],
      "when": { "all": [
        { "input": "knob_pressure", "gt": 2.35 }, { "input": "knob_pressure", "lt": 2.45 },
        { "input": "knob_temp", "gt": 87.5 }, { "input": "knob_temp", "lt": 92.5 },
        { "input": "knob_rpm", "gt": 3150 }, { "input": "knob_rpm", "lt": 3250 } ] }
    },
    {
      "id": "zmart", "name": "Z-Mart checkout", "hints": ["The kiosk shows today's customer, the posters say what the algorithm will push on them.", "Scan four products for that customer at the checkout, in the order from the posters."], "after": ["gate"],
      "when": { "sequence": [
        { "input": "mart_qr", "equals": "Z-BOOST" }, { "input": "mart_qr", "equals": "Z-KIDS" },
        { "input": "mart_qr", "equals": "Z-SNACK" }, { "input": "mart_qr", "equals": "Z-SLEEP" } ] }
    },
    {
      "id": "scanners", "name": "Palm scanners", "hints": ["The palm scanners don't light up by accident.", "Two people, two lit scanners, palms on together for three seconds."], "after": ["wall", "zdrive", "zmart"],
      "when": { "all": [ { "input": "scanner2", "equals": "ON" }, { "input": "scanner3", "equals": "ON" } ] },
      "then": [ { "output": "door_descent", "value": "open" } ]
    },
    {
      "id": "firewall", "name": "Firewall of light", "hints": ["The LEDs above the sensors mark the targets.", "Turn the mirrors so every beam hits a sensor with a lit LED."], "after": ["scanners"],
      "when": { "all": [ { "input": "light1", "gt": 600 }, { "input": "light3", "gt": 600 }, { "input": "light4", "gt": 600 } ] }
    },
    {
      "id": "arming", "name": "Arming", "hints": ["Three rods into the crate, then the code from three fragments.", "ZETA's slogan gives the order to enter the fragments from the stations."], "after": ["firewall"],
      "when": { "all": [
        { "input": "rod1", "equals": "ROD" }, { "input": "rod2", "equals": "ROD" }, { "input": "rod3", "equals": "ROD" },
        { "input": "bomb_code", "equals": "835127" } ] }
    },
    {
      "id": "detonation", "name": "Detonation", "hints": ["Two locks, two keys. The service cabinet.", "Turn both keys at the same moment."], "after": ["arming"], "ends": true,
      "when": { "all": [ { "input": "key_left", "equals": "ON" }, { "input": "key_right", "equals": "ON" } ] },
      "then": [ { "output": "door_exit", "value": "open" } ]
    },
    {
      "id": "deal", "name": "Deal with ZETA", "after": ["arming"], "ends": true,
      "when": { "input": "accept", "equals": "PRESSED" },
      "then": [ { "output": "door_exit", "value": "open" } ]
    }
  ],
  "characters": [
    {
      "name": "RAVEN", "output": "voice", "voice": "N2lVS1w4EtoT3dr4eOWO",
      "about": "A Nomad from the crew in the van below the tower, talks over the radio. Short, street-wise, always on the players' side. Gives hints."
    },
    {
      "name": "ZETA", "output": "voice", "screen": "screen_zeta", "voice": "XB0fDUnXU5powFXDhCwa",
      "about": "Z Corporation's artificial intelligence, the antagonist. Polite as a reception desk in the Lobby, mocking on the Habit Floor, tempting in The Core. Never lies about the puzzles."
    }
