# Copied to /home/sprite/app/env on the Sprite by setup.sh (mode 600). No API keys belong here:
# the model and voice keys live in Sprites Connectors, and the engine only knows their gateway URLs.

# The Sprite's public URL, from `sprite info` (https://<name>-<org-id>.sprites.app).
PUBLIC_URL=https://CHANGE-ME.sprites.app

# Gateway URLs of the two Connectors: https://api.sprites.dev/v1/gateway/<provider>/<connection_id>
# The model Connector must forward to https://openrouter.ai/api, the voice one to https://api.elevenlabs.io
GAMEMASTER_GATEWAY=https://api.sprites.dev/v1/gateway/CHANGE-ME/CHANGE-ME
VOICE_GATEWAY=https://api.sprites.dev/v1/gateway/CHANGE-ME/CHANGE-ME

# What a public demo may spend: games started from a browser per hour, and characters of speech per day.
GAME_STARTS_PER_HOUR=6
VOICE_CHARACTERS_PER_DAY=4000
