# Copied to /home/sprite/app/env on the Sprite by setup.sh (mode 600). No API keys belong here:
# the model and voice keys live in Sprites Connectors, and the engine only knows their gateway URLs.

# The Sprite's public URL, from `sprite info` (https://<name>-<org-id>.sprites.app).
PUBLIC_URL=https://CHANGE-ME.sprites.app

# Gateway URLs of the Connectors: https://api.sprites.dev/v1/gateway/<provider>/<connection_id>
# The model Connector must forward to https://openrouter.ai/api. The voice one can be the same OpenRouter
# gateway (it speaks with ElevenLabs models) or a custom Connector that forwards to https://api.elevenlabs.io
# Left empty, Shadowman runs on rules only and the characters' lines stay text.
GAMEMASTER_GATEWAY=
VOICE_GATEWAY=

# The model Shadowman thinks with, as OpenRouter names it. Any model with tool calling works;
# Claude models ("anthropic/...") go through the Messages API, everything else through chat completions.
GAMEMASTER_MODEL=deepseek/deepseek-v4-flash

# What a public demo may spend: games started from a browser per hour, and characters of speech per day.
GAME_STARTS_PER_HOUR=6
VOICE_CHARACTERS_PER_DAY=4000
